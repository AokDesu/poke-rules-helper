  "narrative": {
    "northStar": "The Town Map guide",
    "overview": "A rules chat set in the colours of a Pokémon region map. The sea-blue shell frames a pale land-green conversation ground. White guide bubbles carry the answers and sea-blue trainer bubbles carry the questions. Rulebook citations are sand-coloured signposts. A guide portrait from one Flaticon pack (Darius Dan, lineal colour) changes with the answer state. Pokéball means reading the rulebook or a failed answer, Pikachu means Claude is answering or answered with citations, Psyduck means an answer with no rulebook citation, Ditto means an unresolved conflict and Snorlax means a scope or privacy block. Every state is also named in text.\n\nThis is an Operate surface: a familiar chat layout comes first. The world supplies only colour, the portraits, the signpost chips and one signature move, the route map. Tapping a signpost opens the Rulebook map, lights its section stop in Pikachu yellow, and opens and focuses the exact passage.",
    "keyCharacteristics": [
      "Conversation thread with a composer docked at the bottom; the newest message is kept in view.",
      "Sources ride on the answer they support, as signposts with tabular line numbers.",
      "The rulebook map stays a click away and never dominates the page.",
      "State stamps (pill headings) and portraits name every answer state; colour never carries it alone."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Only supporting citations wear filled signposts. Follow-up suggestions are sea-tint question pills, never sources.",
        "section": "colors"
      },
      {
        "name": "The One Red Rule",
        "body": "Town Marker Red belongs to Ask. Errors use the separate error ink/ground pair.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** name every state in text next to its portrait and stamp colour.",
      "**Do** keep sources attached to the answer they support and open them in the map, not a modal.",
      "**Do** keep icons from the one stored Flaticon pack (Darius Dan, lineal colour), local under `web/icons/`, credited in the UI and README.",
      "**Do** scroll only the thread; keep the top bar and dock fixed."
    ],
    "donts": [
      "**Don't** hotlink icons or load fonts or other assets from third-party hosts.",
      "**Don't** give follow-up suggestions or any non-citation the filled signpost of a supporting citation.",
      "**Don't** use Town Marker Red for anything but Ask.",
      "**Don't** turn the chat into a game board or invent game-state controls."
    ]
  }
}